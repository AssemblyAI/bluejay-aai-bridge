# Copy to .env and fill in the first two. .env is gitignored.
#   cp .env.example .env

# --- Always ------------------------------------------------------------------
# https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=

# The agent to test, from its URL in the AssemblyAI dashboard. Everything about
# how the agent behaves comes from the agent itself, not from this repo.
AGENT_ID=

# --- Bluejay -----------------------------------------------------------------
# The Basic-auth credentials Bluejay sends on the WebSocket upgrade. You invent
# them; give Bluejay the same pair in the agent's connection settings. Leave
# both empty for local runs, set both on anything you host.
CHIRP_USER=
CHIRP_PASS=

# Your Bluejay API key. Optional: with it, each call's AssemblyAI session id is
# written back onto the simulation result, so the two records point at each
# other. https://docs.getbluejay.ai/test/simulations/tool-calls
# BLUEJAY_API_KEY=

# --- If you keep the agent in this repo instead of just its id ---------------
# Which file in agents/ to publish and test. Usually passed on the command line,
# as in: AGENT=support-line python bridge.py
# AGENT=

# `python publish.py` writes one of these per agent file, so agents/support-line.jsonc
# gets AGENT_ID_SUPPORT_LINE. Present means update that agent, absent means
# create one. You do not set these by hand.
# AGENT_ID_SUPPORT_LINE=

# --- Optional ----------------------------------------------------------------
# DEBUG logs every event and the level of the audio coming in. Default INFO.
# LOG_LEVEL=DEBUG

# Whether what was said appears in the logs. On by default, since watching the
# conversation is how you follow a simulation. Set to 0 on a shared or hosted
# bridge, where the lines land in someone else's log aggregator, or when your
# Digital Humans carry realistic personal data. Turn counts are still logged.
# LOG_TRANSCRIPTS=0

# Port the bridge listens on. Railway and Render set this for you.
# PORT=8767

# Override the upstream Voice Agent WebSocket.
# AAI_WS_URL=wss://agents.assemblyai.com/v1/ws
